---
import { Image } from "astro:assets";

import iconOnlineImage from "@/assets/images/icon-online.svg";
import iconBudgetingImage from "@/assets/images/icon-budgeting.svg";
import iconOnboardingImage from "@/assets/images/icon-onboarding.svg";
import iconAPIImage from "@/assets/images/icon-api.svg";

import ContentWidthWrapper from "@/components/ui/content-width-wrapper.astro";

const cardContents: { title: string; description: string; icon: ImageMetadata }[] = [
    { title: "Online Banking", description: "Our modern web and mobile applications allow you to keep tracck of your finances wherever you are in the world.", icon: iconOnlineImage },
    { title: "Simple Budgeting", description: "See exactly where your money goes each month. Receive notifications when you're close to hitting your limits.", icon: iconBudgetingImage },
    { title: "Fast Onboarding", description: "We don't do branches. Open your account in minutes and start taking control of your finances right away", icon: iconOnboardingImage },
    { title: "Open API", description: "Manage your savings, investments, pension, and much more from one account. Tracking your money has never been faster", icon: iconAPIImage },
];
---

<section data-container class="bg-gray-100">
    <ContentWidthWrapper>
        <div class="px-4 py-15 space-y-12">
            <div class="text-center space-y-4">
                <h2 data-split-words class="text-blue-950 leading-10 text-3xl tracking-[-0.1px]">Why choose Digitalbank?</h2>
                <p data-split-lines class="text-gray-600 text-sm leading-5">We leverage Open Banking to turn your bank account into your financial hub. Control your finances like never before.</p>
            </div>

            <ul class="space-y-10 overflow-hidden" aria-label="App features">
                {
                    cardContents.map((card) => (
                        <ul data-animate-left class="text-center flex flex-col items-center gap-5">
                            <Image src={card.icon} alt={card.title + " Image"} />

                            <h3 class="text-blue-950 text-2xl">{card.title}</h3>
                            <p class="text-center text-gray-600 leading-6 text-sm">{card.description}</p>
                        </ul>
                    ))
                }
            </ul>
        </div>
    </ContentWidthWrapper>
</section>
